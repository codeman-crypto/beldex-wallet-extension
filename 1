{
  "name": "beldex-wallet-extension",
  "version": "1.0.0",
  "private": true,
  "description": "Beldex wallet browser extension (Manifest V3) built on the Beldex LWS wasm core",
  "scripts": {
    "postinstall": "patch-package",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "webpack --mode=production",
    "build:firefox": "webpack --mode=production --env firefox",
    "package": "npm run build && bash scripts/package.sh",
    "dev": "webpack --mode=development --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --disallow-code-generation-from-strings --test test/*.test.mjs"
  },
  "dependencies": {
    "@bdxi/beldex-app-bridge": "^3.0.1",
    "@fontsource/michroma": "^5.2.8",
    "@fontsource/space-mono": "^5.2.9",
    "buffer": "^6.0.3",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "copy-webpack-plugin": "^14.0.0",
    "patch-package": "^8.0.1",
    "ts-loader": "^9.4.4",
    "typescript": "^5.4.0",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  }
}
